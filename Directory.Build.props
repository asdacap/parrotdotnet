<Project>

  <!-- Applies to every project. Deliberately strict: see docs/style.md. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- Strict nullable: enabled everywhere, its warnings are errors via
         TreatWarningsAsErrors, and PARROT0003 removes the "!" escape hatch. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EnableDefaultItems>true</EnableDefaultItems>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <!-- One version for every assembly: BuildInfo reads it off Parrot.Common, so
         setting it per-project would make `parrot version` report the wrong one. -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <!-- Native AOT is the shipping target, so every assembly must stay
       trim- and AOT-clean even before Parrot.Cli links it in. The SDK derives
       the trim, AOT and single-file analyzers from this one switch, which is
       what lets Directory.Build.targets turn them off for test hosts. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Analysis. A warning is a build failure; there is no "fix it later" state. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <ReportAnalyzer>false</ReportAnalyzer>
    <NoWarn></NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Roslyn only runs IDE0005 (unused using) during a build when a
         documentation file is generated: https://github.com/dotnet/roslyn/issues/41640.
         The file is a build artifact, not a deliverable, so CS1591 is off
         (AGENTS.md: no comment unless necessary) and it is not published. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
    <!-- VSTHRD####: async correctness. MIGRATION.md section 3 asserts several
         of these in prose; this makes them compiler errors instead. -->
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>

  <!-- Repository-specific rules that no shipped analyzer expresses. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Parrot.Analyzers'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)tools/Parrot.Analyzers/Parrot.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
