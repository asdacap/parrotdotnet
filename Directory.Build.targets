<Project>

  <!-- Test projects relax nothing. These two are not rule suppressions: a test
       host is not AOT-published, and it has no public API to document. -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsAotCompatible>false</IsAotCompatible>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
