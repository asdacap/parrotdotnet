<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Parrot</RootNamespace>
    <!-- LibraryImport source generation requires it. The only P/Invoke is
         link(), which the storage layout depends on: unlike O_EXCL it is atomic
         on NFS, and unlike rename it reports EEXIST instead of overwriting. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.Generated.cs"
                      Lines="namespace Parrot%3B%0A%0Ainternal static partial class BuildInfo%0A{%0A    public const string Version = &quot;$(Version)&quot;%3B%0A}"
                      Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildInfo.Generated.cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Haikunator" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Config/predefined_config.yaml"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protocol/parrot.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Parrot.Core.Tests" />
    <!-- The CLI's own seams are typed in terms of these, so a test of the CLI
         cannot construct one without them. -->
    <InternalsVisibleTo Include="Parrot.Cli.Tests" />
    <InternalsVisibleTo Include="parrot" />
  </ItemGroup>

</Project>
