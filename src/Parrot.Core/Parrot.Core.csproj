<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Parrot</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Parrot.Common/Parrot.Common.csproj" />
    <ProjectReference Include="../Parrot.Tools/Parrot.Tools.csproj" />
    <ProjectReference Include="../Parrot.Foundation/Parrot.Foundation.csproj" />
    <ProjectReference Include="../Parrot.Infrastructure/Parrot.Infrastructure.csproj" />
    <ProjectReference Include="../Parrot.Llm/Parrot.Llm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Pure.DI" PrivateAssets="all" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Scriban" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="skills/**/*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Parrot.Core.Tests" />
    <!-- The CLI's own seams are typed in terms of these, so a test of the CLI
         cannot construct one without them. -->
    <InternalsVisibleTo Include="Parrot.Cli.Tests" />
    <InternalsVisibleTo Include="Parrot.Tools.Tests" />
    <InternalsVisibleTo Include="parrot" />
  </ItemGroup>

</Project>
