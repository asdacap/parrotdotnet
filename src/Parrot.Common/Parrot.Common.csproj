<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Parrot</RootNamespace>
  </PropertyGroup>

  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.Generated.cs"
                      Lines="namespace Parrot%3B%0A%0Ainternal static partial class BuildInfo%0A{%0A    public const string Version = &quot;$(Version)&quot;%3B%0A}"
                      Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildInfo.Generated.cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="Scriban" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protocol/parrot.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Parrot.Composition" />
    <InternalsVisibleTo Include="Parrot.Tool.Queue" />
    <InternalsVisibleTo Include="Parrot.Tool.Process" />
    <InternalsVisibleTo Include="Parrot.Tool.AgentTask" />
    <InternalsVisibleTo Include="Parrot.Foundation" />
    <InternalsVisibleTo Include="Parrot.Infrastructure" />
    <InternalsVisibleTo Include="Parrot.Llm" />
    <InternalsVisibleTo Include="Parrot.Core" />
    <InternalsVisibleTo Include="Parrot.StatusProviders" />
    <InternalsVisibleTo Include="Parrot.Tools" />
    <InternalsVisibleTo Include="parrot" />
    <InternalsVisibleTo Include="Parrot.Common.Tests" />
    <InternalsVisibleTo Include="Parrot.Foundation.Tests" />
    <InternalsVisibleTo Include="Parrot.Infrastructure.Tests" />
    <InternalsVisibleTo Include="Parrot.Llm.Tests" />
    <InternalsVisibleTo Include="Parrot.Core.Tests" />
    <InternalsVisibleTo Include="Parrot.Tools.Tests" />
    <InternalsVisibleTo Include="Parrot.Cli.Tests" />
  </ItemGroup>

</Project>
