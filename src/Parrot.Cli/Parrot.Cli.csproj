<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>parrot</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Parrot.Cli</RootNamespace>
    <DefineConstants>$(DefineConstants);PUREDI_API_SUPPRESSION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
    <!-- Keep symbols so a core dump from a released binary is still usable,
         matching the Go build's dontStrip. -->
    <StripSymbols>false</StripSymbols>
    <IlcGenerateStackTraceData>true</IlcGenerateStackTraceData>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
  </PropertyGroup>

  <!-- The shipped binary is statically linked against musl: no interpreter, no
       shared library, nothing to install. `musl-clang` comes from the dev
       shell; see the comment on it in flake.nix for why it exists. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-musl-x64'">
    <StaticExecutable>true</StaticExecutable>
    <CppCompilerAndLinker>musl-clang</CppCompilerAndLinker>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore.Web" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Pure.DI" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Parrot.StatusProviders/Parrot.StatusProviders.csproj" />
    <ProjectReference Include="../Parrot.Tool.AgentTask/Parrot.Tool.AgentTask.csproj" />
    <ProjectReference Include="../Parrot.Tool.Queue/Parrot.Tool.Queue.csproj" />
    <ProjectReference Include="../Parrot.Tool.Process/Parrot.Tool.Process.csproj" />
    <ProjectReference Include="../Parrot.Composition/Parrot.Composition.csproj" />
    <ProjectReference Include="../Parrot.Common/Parrot.Common.csproj" />
    <ProjectReference Include="../Parrot.Tools/Parrot.Tools.csproj" />
    <ProjectReference Include="../Parrot.Foundation/Parrot.Foundation.csproj" />
    <ProjectReference Include="../Parrot.Infrastructure/Parrot.Infrastructure.csproj" />
    <ProjectReference Include="../Parrot.Llm/Parrot.Llm.csproj" />
    <ProjectReference Include="../Parrot.Core/Parrot.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <Content Include="$(ArtifactsPath)/obj/$(MSBuildProjectName)/pty-attach/$(Configuration)/$(RuntimeIdentifier)/parrot-pty-attach"
             TargetPath="parrot-pty-attach"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Parrot.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Web/web.proto" GrpcServices="Server" AdditionalImportDirs="../Parrot.Common/Protocol" />
  </ItemGroup>

  <!-- The browser UI is built from web/ and embedded under the "web/" logical
       name prefix. Nix builds it separately and passes -p:ParrotWebDist=<dir>,
       which skips the npm build here. -->
  <PropertyGroup>
    <ParrotWebRoot>$(MSBuildProjectDirectory)/../../web</ParrotWebRoot>
    <ParrotWebBuild Condition="'$(ParrotWebDist)' == ''">true</ParrotWebBuild>
    <ParrotWebDist Condition="'$(ParrotWebDist)' == ''">$(ParrotWebRoot)/dist</ParrotWebDist>
  </PropertyGroup>

  <Target Name="InstallWebUi"
          Inputs="$(ParrotWebRoot)/package-lock.json"
          Outputs="$(ParrotWebRoot)/node_modules/.package-lock.json"
          Condition="'$(ParrotWebBuild)' == 'true'">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(ParrotWebRoot)" />
  </Target>

  <Target Name="BuildWebUi"
          DependsOnTargets="InstallWebUi"
          Inputs="@(ParrotWebSource)"
          Outputs="$(ParrotWebDist)/index.html"
          Condition="'$(ParrotWebBuild)' == 'true'">
    <Exec Command="npm run build" WorkingDirectory="$(ParrotWebRoot)" />
  </Target>

  <ItemGroup>
    <ParrotWebSource Include="$(ParrotWebRoot)/src/**/*" Exclude="$(ParrotWebRoot)/src/gen/**/*" />
    <ParrotWebSource Include="$(ParrotWebRoot)/*.json;$(ParrotWebRoot)/*.ts;$(ParrotWebRoot)/*.mjs;$(ParrotWebRoot)/index.html" />
    <ParrotWebSource Include="Web/web.proto;../Parrot.Common/Protocol/parrot.proto" />
  </ItemGroup>

  <Target Name="EmbedWebUi" DependsOnTargets="BuildWebUi" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <ParrotWebAsset Include="$(ParrotWebDist)/**/*" />
      <EmbeddedResource Include="@(ParrotWebAsset)"
                        LogicalName="web/%(ParrotWebAsset.RecursiveDir)%(ParrotWebAsset.Filename)%(ParrotWebAsset.Extension)" />
    </ItemGroup>
  </Target>

  <Target Name="BuildPtyAttach"
          BeforeTargets="GetCopyToOutputDirectoryItems;ComputeFilesToPublish"
          Inputs="$(MSBuildProjectDirectory)/../Parrot.Infrastructure/Process/Native/parrot-pty-attach.c"
          Outputs="$(ArtifactsPath)/obj/$(MSBuildProjectName)/pty-attach/$(Configuration)/$(RuntimeIdentifier)/parrot-pty-attach"
          Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PropertyGroup>
      <PtyAttachCompiler Condition="'$(RuntimeIdentifier)' == 'linux-musl-x64'">musl-clang</PtyAttachCompiler>
      <PtyAttachCompiler Condition="'$(PtyAttachCompiler)' == ''">cc</PtyAttachCompiler>
      <PtyAttachLinkMode Condition="'$(RuntimeIdentifier)' == 'linux-musl-x64'">-static</PtyAttachLinkMode>
      <PtyAttachOutput>$(ArtifactsPath)/obj/$(MSBuildProjectName)/pty-attach/$(Configuration)/$(RuntimeIdentifier)/parrot-pty-attach</PtyAttachOutput>
    </PropertyGroup>
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(PtyAttachOutput)'))" />
    <Exec Command="&quot;$(PtyAttachCompiler)&quot; -std=c17 -O2 -Wall -Wextra -Wpedantic -Werror $(PtyAttachLinkMode) -o &quot;$(PtyAttachOutput)&quot; &quot;$(MSBuildProjectDirectory)/../Parrot.Infrastructure/Process/Native/parrot-pty-attach.c&quot;" />
  </Target>

</Project>
